{
	email {$ACME_EMAIL}
}

# Si DOMAIN n'est pas défini, Caddy écoute sur le port 80 pour n'importe
# quel hôte (accès par IP) sans tenter d'obtenir de certificat Let's
# Encrypt. Dès que DOMAIN contient un vrai nom de domaine, Caddy bascule
# automatiquement en HTTPS (ACME) sur ce domaine.
{$DOMAIN}

encode gzip

root * /srv
file_server

# Le simulateur est une page unique : pas de cache long sur l'HTML lui-même
# (pour recevoir les mises à jour immédiatement), mais gzip suffit ici.
header /index.html Cache-Control "no-cache"
