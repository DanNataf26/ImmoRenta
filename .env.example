# Copiez ce fichier en ".env" sur le VPS et ajustez les valeurs.

# Nom de domaine pointant vers l'IP du VPS-4 (ex: simulateur.mondomaine.fr).
# Laissez "localhost" pour rester en HTTP simple sans certificat (accès par IP).
DOMAIN=localhost

# Email utilisé pour l'enregistrement du certificat Let's Encrypt (recommandé
# dès que DOMAIN est renseigné). Laissez vide si DOMAIN=localhost.
ACME_EMAIL=
